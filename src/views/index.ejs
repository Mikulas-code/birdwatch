<!DOCTYPE html>
<html lang='en'>

<head>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <title>BirdWatch</title>
</head>

<body>
    <h1>
        <%= title %>
    </h1>
        <fieldset>
      <legend><strong>Přidat nového ptáka</strong></legend>
      <form method="post" action="/add-bird">
        <label>Název ptáka:</label>
        <br />
        <input name="name" size="40" placeholder="např.: Sýkora Koňadra" />
        <br />
        <label>Latinský název:</label>
        <br />
        <input name="latinName" size="40" placeholder="např.: Parus major" />
        <br />
        <label>Řád:</label>
        <br />
        <input name="order" size="40" placeholder="např.: Pěvci" />
        <br />
        <label>Čeleď:</label>
        <br />
        <input name="family" size="40" placeholder="např.: Sýkorovití" />
        <br />
        <label>Datum:</label>
        <br />
        <input type="date" name="date" />
        <br />
        <label>Počet:</label>
        <br />
        <input name="count" size="40"/>
        <br />
        <label>Poznámky:</label>
        <br />
        <input name="notes" size="40"/>
        <br />
        <label>Stav:</label>
        <br />
        <select name="seen">
          <option value=true>Spatřen</option>
          <option value=false>Nespatřen</option>
        </select>
        <br />
        <label>Pohlaví:</label>
        <br/>
        <select name="gender">
          <option value=true>Samec</option>
          <option value=false>Samice</option>
        </select>
        <button type="submit">&#43; Přidat</button>
      </form>
    </fieldset>


    <hr />
    <% for (const bird of birds) { %>
        <div style="border:1px solid black;">
            <h2>
                <%= bird.name %>
            </h2>
            <p>
                <%= bird.latinName %>
            </p>

            <hr />
            <table border="1" cellpadding="6" cellspacing="0">
                <thead>
                    <tr>
                        <th>Řád</th>
                        <th>Čeleď</th>
                        <th>Datum</th>
                        <th>Pohlaví</th>
                        <th>Počet</th>
                        <th>Stav</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <%= bird.order %>
                        </td>
                        <td>
                            <%= bird.family %>
                        </td>
                        <td>
                            <%= bird.date %>
                        </td>
                        <td>
                            <% if (bird.gender===true) { %>
                                Samec
                                <% } else { %>
                                    Samice
                                    <% } %>
                        </td>
                        <td>
                            <%= bird.count %>
                        </td>
                        <td>
                            <% if (bird.seen) { %>
                                <strong>&#10003; Spatřen</strong>
                                <% } else { %>
                                    <em>&#8230; Nespatřen</em>
                                    <% } %>
                        </td>
                    </tr>
                </tbody>
            </table>
            <button>Detail</button>
            <button>Smazat</button>
            <button>Změnit stav</button>
        </div>
        <% } %>
</html>