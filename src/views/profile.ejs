<!DOCTYPE html>
<html lang='en'>

<%- include('partials/head') %>

    <body class="bg-gray-100 min-h-screen">
        <%- include('partials/navigation') %>


            <main class="max-w-2xl mx-auto px-8 py-4">
                <a href="/" class="text-gray-500 hover:text-gray-700 mb-4 inline-block">← Zpět</a>
                <div class="bg-gray-100 rounded-lg shadow p-8 border border-gray-200">
                    <div class="flex flex-col items-center py-4">
                        <div class="w-32 h-32 rounded-full bg-gray-200 flex items-center justify-center mb-4">
                            <% if (user.avatarURL) { %>
                                <img src="/<%= user.avatarURL %>" class="w-32 h-32 rounded-full object-cover"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                                <div class="w-32 h-32 rounded-full bg-gray-200 items-center justify-center hidden">
                                    <span class="text-4xl">🦅</span>
                                </div>
                                <% } %>
                        </div>
                        <h2 class="text-xl font-bold">
                            <%= user.userName %>
                        </h2>
                        <a href="/logout" class="mt-4 bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600">
                            Odhlásit se
                        </a>
                    </div>

                    <details class="mt-4 border-t pt-4">
                        <summary class="cursor-pointer text-green-700 font-medium">Změnit profilovku</summary>
                        <form method="post" action="/upload-avatar" enctype="multipart/form-data"
                            class="mt-3 flex flex-col items-center gap-2">
                            <input type="file" name="avatar" accept="image/*" />
                            <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700">
                                Nahrát
                            </button>
                        </form>
                    </details>
                </div>

            </main>
    </body>

</html>