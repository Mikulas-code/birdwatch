<!DOCTYPE html>
<html lang='en'>

<%- include('partials/head') %>

    <body class="bg-gray-100 min-h-screen">
        <%- include('partials/navigation') %>


            <main class="max-w-2xl mx-auto px-8 py-4">
                <a href="/" class="text-gray-500 hover:text-gray-700 mb-4 inline-block">← Zpět</a>
                <div class="bg-gray-100 rounded-lg shadow p-8 border border-gray-200">
                    <div class="flex flex-col items-center py-4">
                        <div class="w-32 h-32 rounded-full bg-gray-200 flex items-center justify-center mb-4">
                            <% if (user.avatarURL) { %>
                                <img src="/<%= user.avatarURL %>" class="w-32 h-32 rounded-full object-cover"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'" />
                                <div class="w-32 h-32 rounded-full bg-gray-200 items-center justify-center hidden">
                                    <span class="text-4xl">🦅</span>
                                </div>
                                <% } %>
                        </div>
                        <h2 class="text-xl font-bold">
                            <%= user.userName %>
                        </h2>
                        <a href="/logout" class="mt-4 bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600">
                            Odhlásit se
                        </a>
                    </div>

                    <details class="mt-4 border-t pt-4">
                        <summary class="cursor-pointer text-green-700 font-medium">Změnit profilovku</summary>
                        <form method="post" action="/upload-avatar" enctype="multipart/form-data"
                            class="mt-3 flex flex-col items-center gap-2">
                            <input type="file" name="avatar" accept="image/*" />
                            <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded hover:bg-green-700">
                                Nahrát
                            </button>
                        </form>
                    </details>

                    <div class="bg-white rounded-lg shadow p-6 border border-gray-200 mt-4">
                        <h2 class="text-lg font-bold mb-4">Statistiky</h2>

                        <div class="grid grid-cols-2 gap-4 mb-4">
                            <div class="bg-gray-50 rounded-lg p-4">
                                <p class="text-gray-500 text-sm mb-1">Celkem druhů</p>
                                <p class="text-4xl font-bold text-green-600">
                                    <%= stats.totalBirds %>
                                </p>
                            </div>
                            <div class="bg-gray-50 rounded-lg p-4">
                                <p class="text-gray-500 text-sm mb-1">Spatřeno</p>
                                <p class="text-4xl font-bold text-green-600">
                                    <%= stats.seenBirds %>
                                </p>
                                <p class="text-gray-500 text-sm">
                                    <%= stats.totalBirds> 0 ? Math.round((stats.seenBirds / stats.totalBirds) * 100) : 0
                                        %> % ze všech
                                </p>
                            </div>
                        </div>

                        <% if (stats.mostSpotted) { %>
                            <div class="bg-gray-50 rounded-lg p-4 mb-4">
                                <p class="text-gray-500 text-sm mb-1">Nejvíce spatřený pták</p>
                                <p class="text-xl font-bold text-green-600">
                                    <%= stats.mostSpotted.name %>
                                </p>
                                <p class="text-gray-500 italic text-sm">
                                    <%= stats.mostSpotted.latinName %>
                                </p>
                                <p class="text-gray-400 text-sm mt-1">Celkem <%= stats.mostSpotted.count %> kusů</p>
                            </div>
                            <% } %>

                                <div class="bg-gray-50 rounded-lg p-4">
                                    <p class="text-gray-500 text-sm mb-3">Počty podle čeledi</p>
                                    <table class="w-full text-sm">
                                        <thead class="text-gray-500 border-b">
                                            <tr>
                                                <th class="text-left pb-2">Čeleď</th>
                                                <th class="text-right pb-2">Počet</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% stats.byFamily.forEach(([family, count])=> { %>
                                                <tr class="border-b last:border-0">
                                                    <td class="py-2 text-gray-700">
                                                        <%= family %>
                                                    </td>
                                                    <td class="py-2 text-right text-green-600 font-medium">
                                                        <%= count %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                    </div>
                </div>

            </main>
    </body>

</html>