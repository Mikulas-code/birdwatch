<!DOCTYPE html>
<html lang='en'>

<%- include('partials/head') %>

  <body class="bg-gray-100 min-h-screen">
    <%- include('partials/navigation') %>

      <main class="max-w-5xl mx-auto px-8 py-4">
        <form method="post" action="/save-changes/<%= bird.id %>" class="flex gap-6" enctype="multipart/form-data">

          <!-- LEVÝ DIV - fotka -->
          <div
            class="w-[500px] flex-shrink-0 self-start bg-white rounded-lg shadow border border-gray-200 p-4 flex flex-col items-center gap-3">
            <% if (bird.imageURL) { %>
              <img src="/<%= bird.imageURL %>" class="w-full object-cover rounded-lg"
                onerror="this.style.display='none'" />
              <% } else { %>
                <div class="w-full h-64 rounded-lg bg-gray-200 flex items-center justify-center">
                  <span class="text-6xl">🦅</span>
                </div>
                <% } %>
                  <label class="text-sm font-medium text-gray-700 w-full">Změnit fotografii</label>
                  <input type="file" name="image" accept="image/*" class="w-full text-sm" />

                  <% if (bird.lat && bird.lng) { %>
                    <div id="map" class="w-full rounded-lg mt-2" style="height: 400px;"></div>
                    <input type="hidden" name="lat" id="lat" value="<%= bird.lat %>" />
                    <input type="hidden" name="lng" id="lng" value="<%= bird.lng %>" />

                    <script>
                      const map = L.map('map').setView([Number('<%= bird.lat %>'), Number('<%= bird.lng %>')], 13)
                      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map)

                      let marker = L.marker([Number('<%= bird.lat %>'), Number('<%= bird.lng %>')]).addTo(map)

                      map.on('click', (e) => {
                        const { lat, lng } = e.latlng
                        marker.setLatLng([lat, lng])
                        document.getElementById('lat').value = lat
                        document.getElementById('lng').value = lng
                      })
                    </script>
                    <% } %>


          </div>

          <!-- PRAVÝ DIV - pole -->
          <div class="flex-1 bg-white rounded-lg shadow border border-gray-200 p-6 flex flex-col gap-3">
            <h2 class="text-xl font-bold">Upravit ptáka</h2>

            <div>
              <label class="text-sm font-medium text-gray-700">Název ptáka</label>
              <input name="name" value="<%= bird.name %>"
                class="w-full border border-gray-300 rounded px-3 py-2 mt-1 text-sm" />
            </div>
            <div>
              <label class="text-sm font-medium text-gray-700">Latinský název</label>
              <input name="latinName" value="<%= bird.latinName %>"
                class="w-full border border-gray-300 rounded px-3 py-2 mt-1 text-sm" />
            </div>
            <div>
              <label class="text-sm font-medium text-gray-700">Řád</label>
              <input name="order" value="<%= bird.order %>"
                class="w-full border border-gray-300 rounded px-3 py-2 mt-1 text-sm" />
            </div>
            <div>
              <label class="text-sm font-medium text-gray-700">Čeleď</label>
              <input name="family" value="<%= bird.family %>"
                class="w-full border border-gray-300 rounded px-3 py-2 mt-1 text-sm" />
            </div>
            <div>
              <label class="text-sm font-medium text-gray-700">Datum</label>
              <input type="date" name="date" value="<%= bird.date %>"
                class="w-full border border-gray-300 rounded px-3 py-2 mt-1 text-sm" />
            </div>
            <div>
              <label class="text-sm font-medium text-gray-700">Počet</label>
              <input name="count" value="<%= bird.count %>"
                class="w-full border border-gray-300 rounded px-3 py-2 mt-1 text-sm" />
            </div>
            <div>
              <label class="text-sm font-medium text-gray-700">Poznámky</label>
              <input name="notes" value="<%= bird.notes %>"
                class="w-full border border-gray-300 rounded px-3 py-2 mt-1 text-sm" />
            </div>
            <div>
              <label class="text-sm font-medium text-gray-700">Stav</label>
              <select name="seen" class="w-full border border-gray-300 rounded px-3 py-2 mt-1 text-sm">
                <option value="true" <%=bird.seen ? 'selected' : '' %>>Spatřen</option>
                <option value="false" <%=!bird.seen ? 'selected' : '' %>>Nespatřen</option>
              </select>
            </div>
            <div>
              <label class="text-sm font-medium text-gray-700">Pohlaví</label>
              <select name="gender" class="w-full border border-gray-300 rounded px-3 py-2 mt-1 text-sm">
                <option value="true" <%=bird.gender ? 'selected' : '' %>>Samec</option>
                <option value="false" <%=!bird.gender ? 'selected' : '' %>>Samice</option>
              </select>
            </div>


            <% if (bird.audioURL) { %>
              <audio controls class="w-full mt-2">
                <source src="/<%= bird.audioURL %>" type="audio/mpeg" />
              </audio>
              <% } %>
                <div>
                  <label class="text-sm font-medium text-gray-700">Nahrávka zpěvu (MP3)</label>
                  <input type="file" name="audio" accept="audio/*" class="w-full mt-1 text-sm" />
                </div>
                <div class="flex gap-2 mt-2">
                  <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
                    Uložit
                  </button>
                  <a href="/" class="bg-gray-400 text-white px-4 py-2 rounded hover:bg-gray-500">
                    Zrušit
                  </a>
                </div>
          </div>

        </form>
      </main>
  </body>

</html>